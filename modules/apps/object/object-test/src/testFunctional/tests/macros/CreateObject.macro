definition {

	macro addDefinitionLabel {
		Type(
			locator1 = "CreateObject#OBJECT_DEFINITION_LABEL",
			value1 = "${labelName}");
	}

	macro addDefinitionPluralLabel {
		Type(
			locator1 = "CreateObject#OBJECT_DEFINITION_PLURAL_LABEL",
			value1 = "${pluralLabelName}");
	}

	macro assertCustomObject {
		AssertElementPresent(
			key_labelName = "${labelName}",
			locator1 = "CreateObject#OBJECT_NAME");
	}

	macro assertObjectDefinitionName {
		AssertTextEquals(
			locator1 = "CreateObject#OBJECT_DEFINITION_NAME",
			value1 = "${objectName}");
	}

	macro assertObjectLabel {
		AssertTextEquals(
			locator1 = "CreateObject#OBJECT_LABEL",
			value1 = "${labelName}");
	}

	macro assertObjectPluralLabel {
		AssertTextEquals(
			locator1 = "CreateObject#OBJECT_PLURAL_LABEL",
			value1 = "${pluralLabelName}");
	}

	macro createCustomObjectObject {
		CreateObject.openObjectDefinition();

		CreateObject.addDefinitionLabel(labelName = "${labelName}");

		CreateObject.addDefinitionPluralLabel(pluralLabelName = "${pluralLabelName}");

		Click(locator1 = "CreateObject#SAVE_BUTTON_DEFINITION");
	}

	macro editLabel {
		Type(
			locator1 = "CreateObject#OBJECT_LABEL",
			value1 = "${labelName}");
	}

	macro editPluralLabel {
		Type(
			locator1 = "CreateObject#OBJECT_PLURAL_LABEL",
			value1 = "${pluralLabelName}");
	}

	macro openObjectDefinition {
		Click(locator1 = "CreateObject#CREATE_CUSTOM_OBJECT_BUTTON");
	}

	macro saveObject {
		Click(locator1 = "CreateObject#SAVE_BUTTON");
	}

	macro viewObject {
		Click(
			key_labelName = "${labelName}",
			locator1 = "CreateObject#VIEW_OBJECT");
	}

}