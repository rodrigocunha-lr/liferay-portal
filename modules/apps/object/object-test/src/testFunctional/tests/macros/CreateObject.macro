definition {

	macro addObjectField {
		Click.javaScriptClick(locator1 = "CreateObject#ADD_OBJECT_FIELD");

		Type(
			locator1 = "CreateObject#OBJECT_FIELD_LABEL",
			value1 = "Object String Field");

		Select(
			locator1 = "CreateObject#OBJECT_FIELD_TYPE",
			value1 = "String");

		Click(locator1 = "CreateObject#FIELD_SAVE_BUTTON");
	}

	macro assertObjectField {
		AssertElementPresent(
			key_objectFieldLabel = "${objectFieldLabel}",
			key_objectFieldType = "${objectFieldType}",
			locator1 = "CreateObject#ASSERT_OBJECT_FIELD");
	}

	macro assertObjectLabel {
		AssertTextEquals(
			locator1 = "CreateObject#OBJECT_LABEL",
			value1 = "${labelName}");
	}

	macro assertObjectPluralLabel {
		AssertTextEquals(
			locator1 = "CreateObject#OBJECT_PLURAL_LABEL",
			value1 = "${pluralLabelName}");
	}

	macro editLabel {
		Type(
			locator1 = "CreateObject#OBJECT_LABEL",
			value1 = "${labelName}");
	}

	macro editPluralLabel {
		Type(
			locator1 = "CreateObject#OBJECT_PLURAL_LABEL",
			value1 = "${pluralLabelName}");
	}

	macro gotoCreateObject {
		Click(
			key_objectName = "${objectName}",
			locator1 = "CreateObject#CREATE_OBJECT_BUTTON");
	}

	macro gotoNavbar {
		Click(
			key_navItem = "${navItem}",
			locator1 = "CreateObject#TAB_NAVBAR");
	}

	macro saveObject {
		Click(locator1 = "CreateObject#SAVE_BUTTON");
	}

	macro viewObject {
		Click(
			key_labelName = "${labelName}",
			locator1 = "CreateObject#VIEW_OBJECT");
	}

}